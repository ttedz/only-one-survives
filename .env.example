# ============================================================================
#  Only One Survives — environment template
#  Copy to .env in each package as needed. NEVER commit real keys.
# ============================================================================

# ---- contracts/deploy.js (run by YOU, with YOUR wallet) --------------------
# Your deployer wallet private key. Used only locally, only at deploy time.
DEPLOYER_PRIVATE_KEY=0xyour_deployer_key_here
# The game server's wallet address — the only address allowed to report results.
TRUSTED_SERVER_ADDRESS=0xyour_server_wallet_address

# ---- packages/server (.env) ------------------------------------------------
PORT=2567
# The deployed contract address (printed by deploy.js).
CONTRACT_ADDRESS=0xdeployed_contract_address
# The server wallet's key — must match TRUSTED_SERVER_ADDRESS above.
# The server pays the (tiny) gas for recording results, so PLAYERS need no tokens.
SERVER_PRIVATE_KEY=0xyour_server_wallet_key

# ---- packages/client (.env) ------------------------------------------------
VITE_SERVER_URL=ws://localhost:2567
VITE_CONTRACT_ADDRESS=0xdeployed_contract_address
VITE_CHAIN=testnet-asimov
